# Copy this file to .env.local and fill it in (PowerShell: Copy-Item .env.example .env.local).
# .env.local and every other .env file is gitignored; only this example is committed.
#
# Both values are in the Supabase dashboard: your project → Connect (or Project Settings → API Keys).

# Project URL, like https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The PUBLISHABLE key (starts sb_publishable_) or the legacy "anon" key.
# Safe in the browser: Row Level Security decides what it can do.
# NEVER put the secret / service_role key in any VITE_ variable: Vite ships those to every visitor.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public URL put in shared results, like https://dailydarts.example. Defaults to the page's own origin.
VITE_SITE_URL=
