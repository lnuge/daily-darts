{
  "name": "daily-darts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "supabase db push",
    "sync:game": "node scripts/sync-shared-game.mjs",
    "functions:deploy": "npm run sync:game && supabase functions deploy submit-round --use-api && supabase functions deploy delete-account --use-api",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/cabin-sketch": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
