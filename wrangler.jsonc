// Cloudflare Workers config: a static single-page app, no server code.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard (Workers Builds checks this).
  "name": "daily-darts",
  // Not later than the installed workerd release; bump when upgrading wrangler.
  "compatibility_date": "2026-10-12",
  "assets": {
    // Any path that isn't a file (e.g. /leaderboard, /practice/2026-10-15) gets
    // index.html with a 200, and the app's router shows the right screen.
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
}
